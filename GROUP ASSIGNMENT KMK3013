    "# Input section\n",
    "interest = input(\"Your interest (e.g., AI, psychology, neuroscience, education, data analysis, linguistics, healthcare): \")\n",
    "skill = input(\"Your top skill (e.g., programming, communication, research, writing, empathy): \")\n",
    "work_style = input(\"Work style (independent / people-oriented): \")\n",
    "\n",
    "# Recommendation\n",
    "career = recommend_career_smart(interest, skill, work_style)\n",
