    "def recommend_career_smart(interest, skill, work_style):\n",
    "    # Normalize inputs\n",
    "    interest = interest.lower()\n",
    "    skill = skill.lower()\n",
    "    work_style = work_style.lower()\n",
    "\n",
    "    # Smarter matching using keyword mapping\n",
    "    if \"ai\" in interest or \"machine\" in interest:\n",
    "        if \"programming\" in skill and work_style == \"independent\":\n",
    "            return \"AI Engineer or Machine Learning Specialist\"\n",
    "    \n",
    "    elif \"psychology\" in interest:\n",
    "        if \"communication\" in skill and \"people\" in work_style:\n",
    "            return \"Clinical Psychologist or Counselor\"\n",
    "    \n",
    "    elif \"neuro\" in interest:\n",
    "        if \"research\" in skill and work_style == \"independent\":\n",
    "            return \"Neuroscientist or Research Analyst\"\n",
    "    \n",
    "    elif \"education\" in interest or \"teaching\" in interest:\n",
    "        if \"communication\" in skill and \"people\" in work_style:\n",
    "            return \"Lecturer or Educational Psychologist\"\n",
    "    \n",
    "    elif \"data\" in interest or \"analysis\" in interest:\n",
    "        if \"programming\" in skill and work_style == \"independent\":\n",
    "            return \"Data Scientist or Data Analyst\"\n",
    "    \n",
    "    elif \"linguistics\" in interest or \"language\" in interest:\n",
    "        if \"writing\" in skill and work_style == \"independent\":\n",
    "            return \"Computational Linguist or Language Researcher\"\n",
    "    \n",
    "    elif \"health\" in interest or \"care\" in interest:\n",
    "        if \"empathy\" in skill and \"people\" in work_style:\n",
    "            return \"Occupational Therapist or Healthcare Specialist\"\n",
    "    \n",
    "    # Fallback option with advice\n",
    "    return (\n",
    "        \"No exact match found, but here are some suggestions:\\n\"\n",
    "        \"- Explore interdisciplinary roles based on your interests.\\n\"\n",
    "        \"- Try combining your skill in '{}' with areas like AI, health, or education.\".format(skill)\n",
    "    )"
   ]
